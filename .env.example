# Copy to ".env" and adjust before running "docker compose up".
POSTGRES_DB=goa_webapp
POSTGRES_USER=goa
POSTGRES_PASSWORD=change-me

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

APP_PORT=8080

# Max size of a single uploaded file (logo, background, band photo, ...)
# and of the whole multipart request (relevant when several files are
# uploaded together, e.g. a band's main photo + its 6 gallery photos).
APP_MAX_UPLOAD_SIZE=50MB
APP_MAX_UPLOAD_REQUEST_SIZE=200MB
