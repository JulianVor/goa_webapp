# Copy to ".env" and adjust before running "docker compose up".
POSTGRES_DB=goa_webapp
POSTGRES_USER=goa
POSTGRES_PASSWORD=change-me

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

APP_PORT=8080

# Max size of a single uploaded file (logo, background, band photo, ...)
# and of the whole multipart request (relevant when several files are
# uploaded together, e.g. a band's main photo + its 6 gallery photos).
APP_MAX_UPLOAD_SIZE=50MB
APP_MAX_UPLOAD_REQUEST_SIZE=200MB

# Caches parsed Thymeleaf templates instead of re-parsing them on every request.
# Leave at "true" in production; set to "false" only for local dev if you want
# template edits to show up without a restart.
#THYMELEAF_CACHE=true

# The public URL of this site (e.g. https://goa-festival.de, no trailing slash).
# Used to build absolute image/link URLs inside newsletter emails. Only needed if
# the admin panel is reached at a different address than that (e.g. through an
# internal network, or a reverse proxy that terminates HTTPS in front of this
# container) - otherwise the newsletter's images/unsubscribe link end up pointing
# at an address only you can reach, not your actual recipients, and show up broken
# in their mail client. Leave blank if the admin panel's own URL is already the
# public one.
APP_BASE_URL=

# SMTP server used to send the newsletter (see /admin/newsletter). The whole
# newsletter feature (signup button on the site, admin section) is hidden/disabled
# while MAIL_HOST is empty - there's no point collecting addresses you can't reach.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=newsletter@example.com
MAIL_PASSWORD=change-me
# Sender address; most providers require this to match MAIL_USERNAME or a verified
# alias of it. Defaults to MAIL_USERNAME if left empty.
MAIL_FROM=
#MAIL_SMTP_AUTH=true
#MAIL_SMTP_STARTTLS=true

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) on the newsletter signup form,
# to keep it from being spammed by bots. Get a free key pair at
# https://www.google.com/recaptcha/admin (choose "reCAPTCHA v2" / "I'm not a
# robot" checkbox, and add this site's domain). Leave both blank to skip the
# check entirely (e.g. local dev).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
